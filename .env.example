APP_NAME=TimeBee
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===========================
# Database (بيتطابق مع docker-compose.yml)
# ===========================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=timebee_db
DB_USERNAME=timebee_user
DB_PASSWORD=timebee_pass

# ===========================
# JWT
# ===========================
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=1440

# ===========================
# AI (OpenAI أو Mock)
# ===========================
AI_PROVIDER=mock
OPENAI_API_KEY=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
